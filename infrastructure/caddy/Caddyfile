{
	email {$ACME_EMAIL}
	admin off
}

{$DOMAIN} {
	encode zstd gzip

	@api path /api/*
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} {path}/ /index.html
		file_server
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(self), geolocation=(self)"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' https: wss: ws:"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-site
		X-Permitted-Cross-Domain-Policies none
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

{
  "id": "roadsignal-health",
  "name": "RoadSignal — device freshness and alerts",
  "active": false,
  "nodes": [
    {
      "id": "every-minute",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "run-health-check",
      "name": "Run health check",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        160
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "roadsignal-device-health",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "roadsignal-device-health",
      "credentials": {
        "httpHeaderAuth": {
          "id": "roadsignal-internal",
          "name": "RoadSignal local automation"
        }
      }
    },
    {
      "id": "manual-test",
      "name": "Manual test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        320
      ],
      "parameters": {}
    },
    {
      "id": "check-device-freshness",
      "name": "Check device freshness",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/api/v1/monitoring/internal/automation/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {run_key: 'n8n-health:' + $now.toUTC().toFormat('yyyy-MM-dd-HH-mm')} }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "roadsignal-internal",
          "name": "RoadSignal local automation"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Check device freshness",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run health check": {
      "main": [
        [
          {
            "node": "Check device freshness",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual test": {
      "main": [
        [
          {
            "node": "Check device freshness",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Africa/Johannesburg",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  },
  "tags": [],
  "pinData": {}
}

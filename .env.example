STORAGE_BACKEND=mysql
DATABASE_URL=mysql+pymysql://roadsignal:roadsignal@localhost:3306/roadsignal?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0
EVENT_BACKEND=redis
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=roadsignal-api
JWT_AUDIENCE=roadsignal-clients
JWT_EXPIRY_MINUTES=15
REFRESH_EXPIRY_DAYS=30
REQUIRE_AUTH=true
ROUTE_PROVIDER=open
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://routing.openstreetmap.de/routed-car
VALHALLA_URL=http://localhost:8002
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
PROVIDER_TIMEOUT_SECONDS=8
PROVIDER_USER_AGENT=RoadSignal/1.0 (self-hostable routing client)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SEARCH_URL=https://photon.komoot.io/api/
NEXT_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org/search
NEXT_PUBLIC_ROUTER_URL=https://routing.openstreetmap.de/routed-car/route/v1/driving
NEXT_PUBLIC_WEATHER_URL=https://api.open-meteo.com/v1/forecast
EXPO_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
ENVIRONMENT=development
SERVICE_NAME=roadsignal-api
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_BEARER_TOKEN=replace-with-at-least-32-random-characters

# Traffic cameras come from the official i-TRAFFIC developer API, documented at
# https://www.i-traffic.co.za/developers/help (throttled to 10 calls per 60
# seconds; one call per cache window here). There is no self-serve signup --
# request a developer key through https://www.i-traffic.co.za/contact. Their
# terms prohibit automated extraction from the site, so the API is the only
# sanctioned route and this repo deliberately contains no scraper.
# Left empty, the camera layer reports itself unavailable instead of rendering
# empty, because the previous keyless aggregator (opencctv.org) now returns 403.
ITRAFFIC_API_KEY=

# Optional self-hosted AI; no paid model API is required.
AI_ENABLED=false
AI_BASE_URL=http://localhost:8001/v1
AI_MODEL=gpt-oss-20b
AI_TIMEOUT_SECONDS=45
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANKER_BASE_URL=
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
WHISPER_BASE_URL=
WHISPER_MODEL=small
AI_MAX_AUDIO_BYTES=10485760

# Local monitoring overlay mounts a generated token file; never paste it into a workflow.
MONITORING_TOKEN_FILE=
MONITORING_STALE_SECONDS=120
VERIFICATION_BASE_URL=
VISION_BASE_URL=
MONITORING_ROUTE_PROVIDER=valhalla

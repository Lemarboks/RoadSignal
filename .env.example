STORAGE_BACKEND=postgres
DATABASE_URL=postgresql+psycopg://saferoute:saferoute@localhost:5432/saferoute
REDIS_URL=redis://localhost:6379/0
EVENT_BACKEND=redis
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=saferoute-api
JWT_AUDIENCE=saferoute-clients
JWT_EXPIRY_MINUTES=15
REFRESH_EXPIRY_DAYS=30
REQUIRE_AUTH=true
ROUTE_PROVIDER=open
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://routing.openstreetmap.de/routed-car
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
PROVIDER_TIMEOUT_SECONDS=8
PROVIDER_USER_AGENT=SafeRouteAI/1.0 (self-hostable routing client)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SEARCH_URL=https://photon.komoot.io/api/
NEXT_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org/search
NEXT_PUBLIC_ROUTER_URL=https://routing.openstreetmap.de/routed-car/route/v1/driving
NEXT_PUBLIC_WEATHER_URL=https://api.open-meteo.com/v1/forecast
EXPO_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
ENVIRONMENT=development

FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=2
WORKDIR /app
COPY requirements.txt requirements-training.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-training.txt \
    && groupadd --gid 10001 trainer \
    && useradd --uid 10001 --gid trainer --no-create-home trainer \
    && mkdir /candidates && chown trainer:trainer /candidates
COPY app ./app
COPY scripts ./scripts
# Installing the training toolchain is not permission to invent a reviewed dataset.
USER 10001:10001
CMD ["python", "-m", "app.risk.training", "--help"]
